pragma ComponentBehavior: Boundimport QtQuick 6.8import QtQuick.Controls 6.8import QtQuick.Layouts 6.8import "../../scripts/Theme.js" as Paletteimport "../../scripts/EditorShortcuts.mjs" as EditorShortcutsimport ".."Item {    id: root    required property var block    required property int blockIndex    required property real editorWidth    property string uiFontFamily: Palette.fontFamily    signal requestFocusNext(string blockId)    // ── draft state — source of truth while editing ──────────────────────    property string paragraphDraft: ""    property string headingDraft:   ""    property string todoDraft:      ""    property string bulletDraft:    ""    property string syncedBlockId:  ""    // ── derived heading size (inline, no dependency on EditorShortcuts) ──    function headingPx(level) {        if (level === 1) return Math.round(Palette.fontSizeBase * 1.875);        if (level === 2) return Math.round(Palette.fontSizeBase * 1.5);        if (level === 3) return Math.round(Palette.fontSizeBase * 1.25);        return Math.round(Palette.fontSizeBase * 1.1);    }    width:  editorWidth    height: blockRow.implicitHeight    // ── debounce timer: saves to AppState 400ms after last keystroke ──────    Timer {        id: saveTimer        interval: 400        repeat: false        onTriggered: root.flushToState()    }    function flushToState() {        const editor = activeEditor();        if (!editor) return;        if (block.type === "todo") {            AppState.updateTodoBlock(block.id, editor.text, todoCheck.checked);        } else {            AppState.replaceBlockText(block.id, editor.text);        }    }    function scheduleFlush() {        saveTimer.restart();    }    // ─────────────────────────────────────────────────────────────────────    function activeEditor() {        if (block.type === "paragraph") return paragraphEditor;        if (block.type === "heading")   return headingEditor;        if (block.type === "todo")      return todoText;        if (block.type === "bulleted")  return bulletEditor;        return null;    }    function refreshDraftsFromBlock() {        const t = block.text || "";        paragraphDraft = t;        headingDraft   = t;        todoDraft      = t;        bulletDraft    = t;    }    // Only push text into editors that are NOT currently focused    function applyDraftToEditors() {        if (!paragraphEditor.activeFocus) paragraphEditor.text = paragraphDraft;        if (!headingEditor.activeFocus)   headingEditor.text   = headingDraft;        if (!todoText.activeFocus)        todoText.text        = todoDraft;        if (!bulletEditor.activeFocus)    bulletEditor.text    = bulletDraft;    }    function syncDraftsIfIdle() {        const editor = activeEditor();        if (editor && editor.activeFocus) return;   // user is typing — leave it alone        refreshDraftsFromBlock();        applyDraftToEditors();    }    function requestFocus(cursorAtEnd) {        const editor = activeEditor();        if (!editor) return false;        editor.forceActiveFocus();        const pos = cursorAtEnd === false ? 0 : editor.text.length;        editor.cursorPosition = pos;        editor.select(pos, pos);        return true;    }    function mergeWithPrevious(currentText) {        if (blockIndex <= 0) return false;        const prev = AppState.blocks[blockIndex - 1];        if (!prev) return false;        saveTimer.stop();        AppState.replaceBlockText(prev.id, (prev.text || "") + currentText);        AppState.deleteBlock(block.id);        root.requestFocusNext(prev.id);        return true;    }    function deleteEmptyBlock() {        if (blockIndex <= 0) return false;        const prev = AppState.blocks[blockIndex - 1];        if (!prev) return false;        saveTimer.stop();        AppState.deleteBlock(block.id);        root.requestFocusNext(prev.id);        return true;    }    function splitToNewBlock(currentText, cursorPosition, typeName) {        saveTimer.stop();        const before = currentText.slice(0, cursorPosition);        const after  = currentText.slice(cursorPosition);        AppState.replaceBlockText(block.id, before);        const newId = AppState.insertBlockAfter(block.id, typeName);        if (newId && after.length > 0) AppState.replaceBlockText(newId, after);        if (newId) root.requestFocusNext(newId);        return newId;    }    function handleReturn(editor, continueType) {        if (!editor) return;        const text = editor.text;        if (text.length === 0) {            if (block.type === "heading") AppState.convertBlockType(block.id, "paragraph", 1, false);            splitToNewBlock("", 0, "paragraph");            return;        }        splitToNewBlock(text, editor.cursorPosition, continueType);    }    function handleBackspaceAtStart(editor) {        if (!editor) return false;        if (editor.cursorPosition !== 0 || editor.selectionStart !== editor.selectionEnd) return false;        if (editor.text.length === 0) return deleteEmptyBlock();        return mergeWithPrevious(editor.text);    }    function handleShortcut(editor) {        const remainder = EditorShortcuts.tryBlockShortcut(AppState, block.id, editor.text);        if (remainder === null) return false;        saveTimer.stop();        editor.text = remainder;        if (block.type === "paragraph") paragraphDraft = remainder;        else if (block.type === "heading") headingDraft = remainder;        else if (block.type === "todo")    todoDraft    = remainder;        else if (block.type === "bulleted") bulletDraft = remainder;        flushToState();        root.requestFocusNext(block.id);        return true;    }    function processEditorKey(event, editor, continueType) {        if (event.key === Qt.Key_Return) {            if (event.modifiers & Qt.ControlModifier) {                splitToNewBlock(editor.text, editor.cursorPosition, continueType);                event.accepted = true;                return;            }            if (event.modifiers & Qt.ShiftModifier) return;            handleReturn(editor, continueType);            event.accepted = true;            return;        }        if (event.key === Qt.Key_Backspace) {            if (handleBackspaceAtStart(editor)) {                event.accepted = true;            }            return;        }        if (event.modifiers & Qt.ControlModifier) {            if (event.key === Qt.Key_B) {                EditorShortcuts.wrapSelection(editor, "**", "**");                scheduleFlush();                event.accepted = true;            } else if (event.key === Qt.Key_I) {                EditorShortcuts.wrapSelection(editor, "_", "_");                scheduleFlush();                event.accepted = true;            }        }    }    function insertBlockBelow() {        blockTypeMenu.open();    }    // ── react to block changes from outside ──────────────────────────────    onBlockChanged: {        if (block.id !== syncedBlockId) {            syncedBlockId = block.id;            saveTimer.stop();            refreshDraftsFromBlock();            applyDraftToEditors();            return;        }        // Same block updated externally — only sync if nobody is typing        syncDraftsIfIdle();    }    Component.onCompleted: {        syncedBlockId = block.id;        refreshDraftsFromBlock();        applyDraftToEditors();    }    // ── Block-type picker popup (Notion-style) ────────────────────────────    Popup {        id: blockTypeMenu        parent: addBlockButton        x: addBlockButton.width + 6        y: -(blockTypeMenuColumn.implicitHeight / 2) + addBlockButton.height / 2        padding: 6        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside        background: Rectangle {            color: Palette.surface            radius: 8            border.color: Palette.border            border.width: 1        }        Column {            id: blockTypeMenuColumn            spacing: 2            width: 210            Text {                text: "Тип блока"                color: Palette.textSecondary                font.pixelSize: Palette.fontSizeSm                font.family: root.uiFontFamily                leftPadding: 8                topPadding: 4                bottomPadding: 2            }            Repeater {                model: [                    { label: "Текст",       icon: "T",  type: "paragraph", level: 0 },                    { label: "Заголовок 1", icon: "H1", type: "heading",   level: 1 },                    { label: "Заголовок 2", icon: "H2", type: "heading",   level: 2 },                    { label: "Заголовок 3", icon: "H3", type: "heading",   level: 3 },                    { label: "Задача",      icon: "☐",  type: "todo",      level: 0 },                    { label: "Список",      icon: "•",  type: "bulleted",  level: 0 },                ]                delegate: Rectangle {                    required property var modelData                    width: 210                    height: 32                    radius: 6                    color: menuItemMouse.containsMouse ? Palette.hover : "transparent"                    Row {                        anchors.verticalCenter: parent.verticalCenter                        anchors.left: parent.left                        anchors.leftMargin: 8                        spacing: 10                        Text {                            text: modelData.icon                            color: Palette.textSecondary                            font.pixelSize: Palette.fontSizeSm                            font.family: root.uiFontFamily                            font.bold: true                            width: 22                            horizontalAlignment: Text.AlignHCenter                        }                        Text {                            text: modelData.label                            color: Palette.textPrimary                            font.pixelSize: Palette.fontSizeBase                            font.family: root.uiFontFamily                        }                    }                    MouseArea {                        id: menuItemMouse                        anchors.fill: parent                        hoverEnabled: true                        cursorShape: Qt.PointingHandCursor                        onClicked: {                            blockTypeMenu.close();                            const newId = AppState.insertBlockAfter(root.block.id, modelData.type);                            if (newId && modelData.type === "heading" && modelData.level > 0) {                                AppState.convertBlockType(newId, "heading", modelData.level, false);                            }                            if (newId) root.requestFocusNext(newId);                        }                    }                }            }        }    }    // ── Layout ────────────────────────────────────────────────────────────    Row {        id: blockRow        width: parent.width        spacing: 2        HoverHandler { id: blockHover }        Item {            id: addBlockGutter            width: blockHover.hovered ? 28 : 6            height: Math.max(28, blockColumn.implicitHeight)            Behavior on width { NumberAnimation { duration: 100 } }            Rectangle {                id: addBlockButton                anchors.verticalCenter: parent.verticalCenter                anchors.left: parent.left                width: 22                height: 22                radius: 4                color: addBlockMouse.containsMouse ? Palette.hover : "transparent"                opacity: blockHover.hovered || addBlockMouse.containsMouse ? 1 : 0                Behavior on opacity { NumberAnimation { duration: 120 } }                Text {                    anchors.centerIn: parent                    text: "+"                    font.pixelSize: Palette.fontSizeLg                    font.weight: Font.Medium                    color: Palette.textSecondary                }                MouseArea {                    id: addBlockMouse                    anchors.fill: parent                    hoverEnabled: true                    cursorShape: Qt.PointingHandCursor                    onClicked: root.insertBlockBelow()                }            }        }        Column {            id: blockColumn            width: blockRow.width - addBlockGutter.width            spacing: Palette.spacingXs            // ── Paragraph ─────────────────────────────────────────────────            TextEdit {                id: paragraphEditor                visible: block.type === "paragraph"                width: parent.width                leftPadding: 2                rightPadding: 2                topPadding: 4                bottomPadding: 4                wrapMode: TextEdit.Wrap                textFormat: TextEdit.PlainText                font.family: root.uiFontFamily                font.pixelSize: Palette.fontSizeBase                color: Palette.textPrimary                selectByMouse: true                selectionColor: Palette.selected                selectedTextColor: Palette.textPrimary                onActiveFocusChanged: {                    if (!activeFocus) {                        root.paragraphDraft = text;                        saveTimer.stop();                        root.flushToState();                    }                }                onTextChanged: {                    if (!activeFocus) return;                    root.paragraphDraft = text;                    if (handleShortcut(paragraphEditor)) return;                    scheduleFlush();                }                Keys.onPressed: function (event) {                    root.processEditorKey(event, paragraphEditor, "paragraph");                }            }            // ── Heading ───────────────────────────────────────────────────            TextEdit {                id: headingEditor                visible: block.type === "heading"                width: parent.width                leftPadding: 2                rightPadding: 2                topPadding: 6                bottomPadding: 6                wrapMode: TextEdit.Wrap                textFormat: TextEdit.PlainText                font.family: root.uiFontFamily                font.bold: true                font.pixelSize: root.headingPx(block.level || 1)                color: Palette.textPrimary                selectByMouse: true                selectionColor: Palette.selected                selectedTextColor: Palette.textPrimary                onActiveFocusChanged: {                    if (!activeFocus) {                        root.headingDraft = text;                        saveTimer.stop();                        root.flushToState();                    }                }                onTextChanged: {                    if (!activeFocus) return;                    root.headingDraft = text;                    if (handleShortcut(headingEditor)) return;                    scheduleFlush();                }                Keys.onPressed: function (event) {                    root.processEditorKey(event, headingEditor, "paragraph");                }            }            // ── Todo ──────────────────────────────────────────────────────            RowLayout {                visible: block.type === "todo"                spacing: Palette.spacingSm                width: parent.width                AppSwitch {                    id: todoCheck                    checked: block.done === true                    onToggled: {                        saveTimer.stop();                        AppState.updateTodoBlock(block.id, todoText.text, checked);                    }                }                TextEdit {                    id: todoText                    wrapMode: TextEdit.Wrap                    Layout.fillWidth: true                    leftPadding: 2                    rightPadding: 2                    topPadding: 4                    bottomPadding: 4                    textFormat: TextEdit.PlainText                    font.family: root.uiFontFamily                    font.pixelSize: Palette.fontSizeBase                    color: todoCheck.checked ? Palette.textSecondary : Palette.textPrimary                    font.strikeout: todoCheck.checked                    selectByMouse: true                    selectionColor: Palette.selected                    selectedTextColor: Palette.textPrimary                    onActiveFocusChanged: {                        if (!activeFocus) {                            root.todoDraft = text;                            saveTimer.stop();                            root.flushToState();                        }                    }                    onTextChanged: {                        if (!activeFocus) return;                        root.todoDraft = text;                        if (handleShortcut(todoText)) return;                        scheduleFlush();                    }                    Keys.onPressed: function (event) {                        root.processEditorKey(event, todoText, "todo");                    }                }            }            // ── Bulleted list ─────────────────────────────────────────────            RowLayout {                visible: block.type === "bulleted"                spacing: 6                width: parent.width                Text {                    text: "•"                    color: Palette.textPrimary                    font.pixelSize: Palette.fontSizeBase                    font.family: root.uiFontFamily                    Layout.alignment: Qt.AlignTop                    topPadding: 4                }                TextEdit {                    id: bulletEditor                    wrapMode: TextEdit.Wrap                    Layout.fillWidth: true                    leftPadding: 2                    rightPadding: 2                    topPadding: 4                    bottomPadding: 4                    textFormat: TextEdit.PlainText                    font.family: root.uiFontFamily                    font.pixelSize: Palette.fontSizeBase                    color: Palette.textPrimary                    selectByMouse: true                    selectionColor: Palette.selected                    selectedTextColor: Palette.textPrimary                    onActiveFocusChanged: {                        if (!activeFocus) {                            root.bulletDraft = text;                            saveTimer.stop();                            root.flushToState();                        }                    }                    onTextChanged: {                        if (!activeFocus) return;                        root.bulletDraft = text;                        if (handleShortcut(bulletEditor)) return;                        scheduleFlush();                    }                    Keys.onPressed: function (event) {                        root.processEditorKey(event, bulletEditor, "bulleted");                    }                }            }        }    }}